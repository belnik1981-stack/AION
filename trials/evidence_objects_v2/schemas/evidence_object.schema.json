{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aion.local/schemas/evidence_object-v2.json",
  "title": "AION EvidenceObject v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "evidence_id",
    "evidence_version",
    "raw_artifact_ref",
    "claim_ref",
    "extraction",
    "relation",
    "declared_dependency_roots",
    "quality"
  ],
  "properties": {
    "object_type": {"const": "evidence_object"},
    "schema_version": {"const": "2.0"},
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "evidence_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "raw_artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_version", "content_sha256"],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_version": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claim_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "claim_version"],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "claim_version": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "method_version",
        "start_byte",
        "end_byte",
        "fragment_sha256"
      ],
      "properties": {
        "method": {"const": "utf8_byte_span"},
        "method_version": {"const": "1.0"},
        "start_byte": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "end_byte": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "fragment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "relation": {
      "type": "string",
      "enum": ["supports", "contradicts", "context"]
    },
    "declared_dependency_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}@[1-9][0-9]{0,6}$"
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodology", "primary_data", "reproducibility"],
      "properties": {
        "methodology": {
          "type": "string",
          "enum": ["described", "partial", "hidden", "not_applicable"]
        },
        "primary_data": {
          "type": "string",
          "enum": ["available", "partial", "unavailable", "not_applicable"]
        },
        "reproducibility": {
          "type": "string",
          "enum": ["reproduced", "possible", "impossible", "unknown"]
        }
      }
    }
  }
}
